{
  "manifest_version": 3,
  "name": "X Workspace",
  "version": "0.1.1",
  "description": "A focused X feed with a resizable native chat pane.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "X Workspace" },
  "content_scripts": [{
    "matches": ["https://x.com/*"],
    "js": ["content.js"],
    "css": ["layout.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
